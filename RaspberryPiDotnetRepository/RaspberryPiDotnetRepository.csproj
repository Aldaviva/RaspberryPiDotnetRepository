<Project Sdk="Microsoft.NET.Sdk.Worker">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.5.1</Version>
        <Authors>Ben Hutchison</Authors>
        <Copyright>© 2026 $(Authors)</Copyright>
        <Company>$(Authors)</Company>
        <LangVersion>latest</LangVersion>
        <RollForward>latestMajor</RollForward>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ApplicationIcon>rpi-dotnet.ico</ApplicationIcon>
        <SelfContained>false</SelfContained>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="rpi-dotnet.ico" />
        <None Include="..\Readme.md;..\.github*\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Azure.ResourceManager.Cdn" Version="1.6.0" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
        <PackageReference Include="Bom.Squad" Version="0.3.0" />
        <PackageReference Include="Corvus.Text.Json" Version="5.8.8" />
        <PackageReference Include="Corvus.Text.Json.SourceGenerator" Version="5.8.8" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="DataSizeUnits" Version="4.0.1" />
        <PackageReference Include="LibObjectFile" Version="2.3.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
        <PackageReference Include="PgpCore" Version="8.1.1" />
        <PackageReference Include="ThrottleDebounce" Version="3.0.0" />
        <PackageReference Include="Unfucked" Version="0.0.1-beta.62" />
        <PackageReference Include="Unfucked.Compression" Version="0.0.1-beta.6" />
        <PackageReference Include="Unfucked.DI" Version="0.0.1-beta.21" />
        <PackageReference Include="Unfucked.HTTP" Version="0.0.1-beta.42" />
        <PackageReference Include="Unfucked.PGP" Version="0.0.1-beta.4" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup Condition="'$(CI)' == 'true' or '$(Configuration)' != 'Debug'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Generate C# types from JSON Schema -->
    
    <PropertyGroup Label="Schema autogenerated JSON">
        <CorvusTextJsonUseImplicitOperatorString>true</CorvusTextJsonUseImplicitOperatorString>
        <CorvusTextJsonOptionalAsNullable>NullOrUndefinedExceptNonNullDefaulted</CorvusTextJsonOptionalAsNullable>
    </PropertyGroup>
    
    <Target Name="DownloadJsonSchema" BeforeTargets="BeforeBuild" Outputs="Data\dotnet-releases-index.json">
        <DownloadFile SourceUrl="https://www.schemastore.org/dotnet-releases-index.json" DestinationFolder="Data" SkipUnchangedFiles="true" />
    </Target>
    
    <ItemGroup Label="Schema autogenerated JSON">
        <AdditionalFiles Include="Data\dotnet-releases-index.json" />
    </ItemGroup>
</Project>